{
    "Version": "2012-10-17",
    "Statement": [
        {
            "Sid": "Route53ChangeRecords",
            "Effect": "Allow",
            "Action": [
                "route53:ChangeResourceRecordSets",
                "route53:ListResourceRecordSets"
            ],
            "Resource": "arn:aws:route53:::hostedzone/Z0090885357R3XH6AW0MQ"
        },
        {
            "Sid": "Route53GetChange",
            "Effect": "Allow",
            "Action": [
                "route53:GetChange"
            ],
            "Resource": "arn:aws:route53:::change/*"
        },
        {
            "Sid": "Route53ListHostedZonesByName",
            "Effect": "Allow",
            "Action": [
                "route53:ListHostedZonesByName"
            ],
            "Resource": "*"
        }
    ]
}
